:: StoryCaption
<<if $gameStarted>>\
<<include "Player Avatar">>\
Name: $player.name
Level: $player.level
Location: $player.location
<<getTimeString>>

Gold - $player.gold
<hr>
<center><table style="width:100%">
    <tr>
    <td><strong>STR:</strong> $player.stats.str (<<getAbilityModifierStringForPlayer str>>)</td>
    <td><strong>DEX:</strong> $player.stats.dex (<<getAbilityModifierStringForPlayer dex>>)</td>
    </tr>
    <tr>
    <td><strong>CON:</strong> $player.stats.con (<<getAbilityModifierStringForPlayer con>>)</td>
    <td><strong>WIS:</strong> $player.stats.wis (<<getAbilityModifierStringForPlayer wis>>)</td>
    </tr>
    <tr>
    <td><strong>INT:</strong> $player.stats.int (<<getAbilityModifierStringForPlayer int>>)</td>
    <td><strong>CHA:</strong> $player.stats.cha (<<getAbilityModifierStringForPlayer cha>>)</td>
    </tr>
</table></center>\
<hr>
<div class="meter-container"><center><<showmeter "healthMeter" `$player.health / $player.maxHealth`>></center></div>\
<div class="meter-container"><center><<showmeter "manaMeter" `$player.mana / $player.maxMana`>></center></div>\
<hr>




