:: Encounter
<<for _message range $currentEncounter.messages>>\
    _message
<</for>>\

<<if $currentEncounter.status == 'active'>>\
''Round $currentEncounter.round''

<<set _aliveEnemies = setup.getAliveEnemies()>>\
<<for _enemy range _aliveEnemies>>\
    <<set _enemyDefinition = setup.getDefinition('enemies', _enemy.definitionId)>>\
    _enemyDefinition.name: _enemy.health / _enemyDefinition.maxHealth health
<</for>>\

<hr>
Who would you like to target?
<<set _selectedTarget = setup.getEnemyById($currentEncounter.selectedTargetId)>>\
<<if !_selectedTarget || _selectedTarget.health lte 0>>\
    <<set $currentEncounter.selectedTargetId = _aliveEnemies[0].id>>\
<</if>>\
<<for _enemy range _aliveEnemies>>\
    <<set _enemyDefinition = setup.getDefinition('enemies', _enemy.definitionId)>>\
    <<radiobutton "$currentEncounter.selectedTargetId" _enemy.id `_enemy.id === $currentEncounter.selectedTargetId ? 'checked' : ''`>> _enemyDefinition.name
<</for>>\

What would you like to do?
<<for _actionId range $currentEncounter.playerActionIds>>\
    <<set _action = setup.getDefinition('items', _actionId)>>\
    <<radiobutton "$currentEncounter.selectedActionId" _actionId `_actionId === $currentEncounter.selectedActionId ? 'checked' : ''`>> _action.attackDescription
<</for>>\

<<link "Confirm" "Encounter">><<progressEncounter $currentEncounter.selectedActionId $currentEncounter.selectedTargetId>><</link>>
<<elseif $currentEncounter.status == 'won'>>\
Encounter Complete!

<<processEncounterWon>>

<<link "Exit" $currentEncounter.returnPassage>><<endEncounter>><<incrementTime 0 3>><</link>>
<<elseif $currentEncounter.status == 'lost'>>\
You pass out from the pain of the battle. Time passes by until you awaken.

<<link "Continue" $currentEncounter.returnPassage>><<endEncounter>><<incrementTime 3 17>><</link>>
<<else>>\
There is no active encounter.

[[Return to Town|Town Center]]
<</if>>
