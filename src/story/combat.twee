:: Encounter
<<for _i to 0; _i lt $currentEncounter.enemyActions.length; _i++>>\
    $currentEncounter.enemyActions[_i]
<</for>>\

$currentEncounter.playerAction
<hr>\
<<if !$currentEncounter.encounterEnded>>\
<<for _i to 0; _i lt $currentEncounter.enemies.length; _i++>>\
    <<set _enemy = $currentEncounter.enemies[_i]>>\
    <<set _enemyDefinition = setup.getDefinition('enemies', _enemy.definitionId)>>\
    _enemyDefinition.name has _enemy.health health remaining.
<</for>>\

<hr>
Who would you like to target?
<<if !$currentEncounter.targetIndex>>\
  <<set $currentEncounter.targetIndex = 0>>\
<</if>>\
<<for _i to 0; _i lt $currentEncounter.enemies.length; _i++>>\
    <<set _enemy = $currentEncounter.enemies[_i]>>\
    <<set _enemyDefinition = setup.getDefinition('enemies', _enemy.definitionId)>>\
    <<radiobutton "$currentEncounter.targetIndex" _i `_i === $currentEncounter.targetIndex ? 'checked' : ''`>> _enemyDefinition.name
<</for>>\

What would you like to do?
<<if !$currentEncounter.actionId>>\
  <<set $currentEncounter.actionId = $currentEncounter.playerActionIds[0]>>\
<</if>>\
<<for _i to 0; _i lt $currentEncounter.playerActionIds.length; _i++>>\
    <<set _actionId = $currentEncounter.playerActionIds[_i]>>\
    <<set _action = setup.getDefinition('items', _actionId)>>\
    <<radiobutton "$currentEncounter.actionId" _actionId `_actionId === $currentEncounter.actionId ? 'checked' : ''`>> _action.attackDescription
<</for>>\


<<link "Confirm" "Encounter">><<progressEncounter $currentEncounter.actionId $currentEncounter.targetIndex>><</link>>
<<else>>
  <<if $currentEncounter.playerWonEncounter>>
  Encounter Complete!

  <<processEncounterWon>>

  <<link "Exit" $player.locationBeforeEncounter>><<endEncounter>><<incrementTime 0 3>><</link>>
  <<else>>
  You pass out from the pain of the battle. Time passes by until you awaken.

  <<link "Continue" $player.locationBeforeEncounter>><<endEncounter>><<incrementTime 3 17>><</link>>
  <</if>>
<</if>>
